# Ports — Docker host port mapping (change if the default port is taken on your machine)
PORT_BACKEND=8000
PORT_DB=5432
PORT_REDIS=6379

DATABASE_URL=postgresql://user:password@localhost/kard_db
JWT_SECRET_KEY=your-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REDIS_URL=redis://localhost:6379
# Nombre del producto tal como lo ven las personas (correos, título de la API).
BRAND_NAME=KARD
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Resend — transactional email
# Get your API key at https://resend.com → API Keys
# Leave empty to disable email sending (safe for local dev without Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com
# Remitente visible. Vacío = usa BRAND_NAME.
EMAIL_FROM_NAME=
APP_URL=http://localhost:3000

# ── Stripe — suscripciones de los negocios hacia KARD ──────────────────────
# Claves de PRUEBA (empiezan con sk_test_). Panel → Desarrolladores → Claves API.
# Dejarlas vacías desactiva el cobro: el resto de la plataforma sigue
# funcionando y los endpoints de billing responden 503 con un mensaje claro.
STRIPE_SECRET_KEY=

# Firma de los webhooks. En local la imprime:
#   stripe listen --forward-to localhost:8000/api/v1/billing/webhook
STRIPE_WEBHOOK_SECRET=

# Precios de cada plan (Panel → Catálogo de productos).
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ENTERPRISE=price_xxxxxxxxxxxxxxxxxxxxxxxx

# Cola de devoluciones de inventario (cancelar un pedido): cada cuántos segundos revisa si quedó
# algo pendiente (reintentos y lo que un reinicio dejó a medias). 0 = no revisa.
STOCK_RETURN_SWEEP_SECONDS=30
