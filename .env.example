# Ports — Docker host port mapping (change if the default port is taken on your machine)
PORT_BACKEND=8000
PORT_DB=5432
PORT_REDIS=6379

DATABASE_URL=postgresql://user:password@localhost/kard_db
JWT_SECRET_KEY=your-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REDIS_URL=redis://localhost:6379
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Resend — transactional email
# Get your API key at https://resend.com → API Keys
# Leave empty to disable email sending (safe for local dev without Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=KARD
APP_URL=http://localhost:3000
